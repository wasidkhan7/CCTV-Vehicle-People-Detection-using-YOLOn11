```gitignore
# Python
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
torch-venv/

# Environment variables and secrets
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# Generated videos
outputs/*
!outputs/.gitkeep

# Temporary files
*.tmp
*.log

# Operating system
.DS_Store
Thumbs.db

# Model training artifacts
runs/
wandb/
```